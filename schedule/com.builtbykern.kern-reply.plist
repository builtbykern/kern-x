<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.builtbykern.kern-reply</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__KERN_X_ROOT__/scripts/schedule_reply_loop.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__KERN_X_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__KERN_X_ROOT__/logs/x-cycle.log</string>
  <key>StandardErrorPath</key>
  <string>__KERN_X_ROOT__/logs/x-cycle.err</string>
  <key>ThrottleInterval</key>
  <integer>300</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
</dict>
</plist>
